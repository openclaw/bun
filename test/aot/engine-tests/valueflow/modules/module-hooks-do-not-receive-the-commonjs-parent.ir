# Hooks do not receive the CommonJS parent; legacy replacements do.
# Keep entry exports inside the closed image to isolate the parent's handoff.
# REQUIRES: entries-of-bun
# OPTIONS: exclude=CodeOutsideImage
# RUN: link functions
# CHECK: function f2 unreached

variable g0 name="exports" module=m0 declared={type=anything} initialization=Undefined
module m0 path="/app/main.cjs" displayPath="main.cjs" kind=CommonJs flags=[KeepsError] exportRule=CommonJs requireResult=ModuleExports body=f0 exportsVariable=g0
entry module=m0 hostReads=[{exportName="default" builtin=BunServe namesLookedFor=["fetch", "app"]}, {exportName="then"}]
layout L0 kind=Record name="options"
function f0 name="main" module=m0 kind=CommonJsModule thisType={type=anything} results=[{type=anything}] {
    v0 = NewClosure function=f2
    PutModuleVariable v0 variable=g0
    v2 = Builtin builtin=GlobalThis
    v3 = NewClosure function=f1
    PropSet v2, v3 key="kept" mode=Strict
    v5 = Builtin builtin=NodeModuleRegisterHooks
    v6 = NewObject layout=L0 fields=[]
    v7 = Undefined
    PropSet v6, v7 key="_compile" mode=Strict
    v9 = Call v5, -, v6
    v10 = String string="asked"
    v11 = ResolveDynamic v10 referrer=m0
    Return
}
function f1 name="resolve" module=m0 parameters=[{type=anything}, {type=anything}] results=[{type=anything}] {
    v2 = PropGet v1 key="exports"
    v3 = Call v2
    Return v3
}
function f2 name="hidden" module=m0 results=[{type=anything}] {
    Return
}
