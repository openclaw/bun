+type DoctorPhaseCase = "cached-true" | "cached-false";
+type DoctorPhaseStage =
+  | "fixture-create"
+  | "gateway-acquire"
+  | "maintenance-acquire"
+  | "service-gateway-release"
+  | "service-db-close"
+  | "before-state-mutation"
+  | "baseline-capture"
+  | "maintenance-read"
+  | "maintenance-release"
+  | "finally-maintenance-release"
+  | "finally-gateway-release"
+  | "finally-isolation"
+  | "after-each-db-async"
+  | "after-each-db-sync"
+  | "after-each-directories"
+  | "after-each-mocks"
+  | "after-each-env";
+
+const doctorPhaseCounts = { "cached-true": 0, "cached-false": 0 };
+
+export function traceDoctorPhase(
+  caseId: DoctorPhaseCase | undefined,
+  stage: DoctorPhaseStage,
+  event: "enter" | "returned",
+  cycle = -1,
+) {
+  if (!caseId || doctorPhaseCounts[caseId] >= 65) {
+    return;
+  }
+  const seq = ++doctorPhaseCounts[caseId];
+  try {
+    process.stderr.write(
+      "[doctor-phases] " +
+        JSON.stringify({
+          v: 1,
+          case: caseId,
+          seq,
+          stage: seq === 65 ? "overflow" : stage,
+          event: seq === 65 ? "overflow" : event,
+          cycle: seq === 65 ? -1 : cycle,
+        }) +
+        "\n",
+    );
+  } catch {
+    // Diagnostic write failures must not replace the operation's original outcome.
+  }
+}
